{
  "name": "alco-bot",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=\\\"--dns-result-order=ipv4first\\\" PINO_PRETTY=1 tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "db:reset": "node -e \"console.log(\" + JSON.stringify(\"WARNING: удаление данных!\") + \")\" && psql \"\\$DATABASE_URL\" -c \"DROP SCHEMA public CASCADE; CREATE SCHEMA public;\" && npm run migrate",
    "smoke": "tsx scripts/smoke.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bullmq": "^5.58.8",
    "ioredis": "^5.8.0",
    "node-telegram-bot-api": "^0.63.0",
    "pg": "^8.16.3",
    "pino": "^9.11.0",
    "postgres": "^3.4.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node-telegram-bot-api": "^0.64.11",
    "dotenv": "^17.2.2",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.5"
  }
}
